# Nirvana 3D — SPA routing + security headers (public_html/.htaccess)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_authz_core.c>
  <FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|vite\.config\.(js|ts)|README\.md)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|vite\.config\.(js|ts)|README\.md)$">
    Deny from all
  </FilesMatch>
</IfModule>
RewriteEngine On

# HTTPS is expected in production. Set FORCE_HTTPS=0 in the server config only
# if TLS is terminated upstream and Apache does not receive HTTPS metadata.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# sitemap.xml → تولید پویا از API
RewriteRule ^sitemap\.xml$ api/index.php?_r=/sitemap [L]

# API و فایل‌های واقعی دست‌نخورده
RewriteRule ^api/ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# بقیهٔ مسیرها → index.html (React Router)
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # CSP compatible with Vite single-file inline scripts/styles + self-hosted assets + Zarinpal
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://*.zarinpal.com https://sandbox.zarinpal.com https://raw.githubusercontent.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # Cache static index.html no-store for HTML, but allow revalidate
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# جلوگیری از اجرای PHP در پوشهٔ آپلود
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F]
</IfModule>
